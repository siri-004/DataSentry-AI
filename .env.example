# ==========================================
# DataSentry AI Configuration
# ==========================================

# Google Gemini API Key (Recommended - Free via https://aistudio.google.com/)
GEMINI_API_KEY=your_gemini_api_key_here
LLM_PROVIDER=gemini
LLM_MODEL=gemini-2.0-flash

# Optional: OpenAI / OpenAI-compatible API key (alternative)
# OPENAI_API_KEY=your_openai_api_key_here
# OPENAI_BASE_URL=https://api.openai.com/v1
# LLM_PROVIDER=openai
# LLM_MODEL=gpt-4o-mini

# LLM Settings
LLM_TEMPERATURE=0.1
LLM_TIMEOUT_SECONDS=30

# File upload and data bounds
MAX_FILE_SIZE_MB=25
MAX_ROWS_LIMIT=100000
